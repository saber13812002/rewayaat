ES_INDEX=rewayaat_corpus_v1
NEO4J_CONTAINER=neo4j_db
NEO4J_USER=neo4j
NEO4J_ENV_FILE=/home/saber/saberprojects/graph-rag/.env

# services
RAG_PROVIDER_URL=http://127.0.0.1:8107
