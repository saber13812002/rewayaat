# Drives sync.service every 6 hours (fixed wall-clock times).
# Persistent=true: if the server was down at a scheduled tick, the run
# catches up once on the next user-manager start.
[Unit]
Description=Run the Rewayaat corpus-sync snapshot every 6 hours

[Timer]
# Every 6 hours at fixed wall-clock times (00:00/06:00/12:00/18:00).
# NB: the step belongs to the HOUR field. `*:00/6` would step the
# MINUTE field (fires every 6 minutes) - systemd-analyze calendar
# confirms `0/6:00` yields 00:00, 06:00, 12:00, 18:00.
OnCalendar=*-*-* 0/6:00
Persistent=true
RandomizedDelaySec=300
Unit=sync.service

[Install]
WantedBy=timers.target
