# Rewayaat SSE shim env (mirrors shim/shim-alghadir.env).
# __UPSTREAM__ = DRAG_SERVICE_TOKEN (provider bearer), __SERVICE__ = fresh
# random token used by the nginx bridge / callers of the shim.
SHIM_NAME=rag-rewayaat-shim
SHIM_PORT=8130
SHIM_ASK_URL=http://127.0.0.1:8107/v1/ask
SHIM_UPSTREAM_TOKEN=__UPSTREAM__
SHIM_SERVICE_TOKEN=__SERVICE__
SHIM_TOP_K=5
SHIM_ASK_TIMEOUT=200
