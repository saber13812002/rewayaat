# Rewayaat RAG provider env (mirrors env/khamenei.env).
# __TOKEN__ is replaced at deploy time with a fresh `openssl rand -hex 32`
# value, which is ALSO written to the registry + gateway env files as
# REWAYAAT_PROVIDER_TOKEN.
DRAG_SOURCE_ID=rewayaat
DRAG_DB_PATH=/data/drag.db
DRAG_SERVICE_TOKEN=__TOKEN__
DRAG_EMBED_ENDPOINTS=http://172.20.1.53:11434/v1|mxbai-embed-large
DRAG_EMBED_DIM=1024
DRAG_EMBED_VERSION=mxbai-embed-large-v1
DRAG_EMBED_BATCH=32
DRAG_CHAT_ENDPOINT=http://172.22.188.80:8000/v1
DRAG_CHAT_MODEL=qwen3.8-27b-uncensored
DRAG_PRODUCTION_MODE=1
DRAG_DEFAULT_TOPK=5
DRAG_HYBRID_ALPHA=0.6
